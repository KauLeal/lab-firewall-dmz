// Zonas do laboratorio
zone "lab.local" {
    type master;
    file "/etc/bind/db.lab.local";
};

zone "ext.lab" {
    type master;
    file "/etc/bind/db.ext.lab";
};

zone "1.0.10.in-addr.arpa" {
    type master;
    file "/etc/bind/db.10.0.1";
};

zone "2.0.10.in-addr.arpa" {
    type master;
    file "/etc/bind/db.10.0.2";
};
