#!/bin/bash
# dns - Servidor DNS autoritativo da DMZ
ip address add 10.0.2.11/24 dev eth0
ip link set dev eth0 up
ip route add default via 10.0.2.1
echo "nameserver 127.0.0.1" > /etc/resolv.conf
echo "dns" > /etc/hostname; hostname dns

chown -R root:bind /etc/bind 2>/dev/null
( service named start || service bind9 start || /etc/init.d/bind9 start || /usr/sbin/named -u bind ) >/dev/null 2>&1
