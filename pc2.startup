#!/bin/bash
# pc2 - estacao da LAN (sera tratada como "host comprometido" no exp. de L2)
ip link set dev eth0 down
ip link set dev eth0 address 00:00:00:00:01:11
ip link set dev eth0 up
ip address add 10.0.1.11/24 dev eth0
ip route add default via 10.0.1.1

echo "nameserver 10.0.2.11" > /etc/resolv.conf
echo "pc2" > /etc/hostname; hostname pc2
chmod +x /root/bin/*.sh 2>/dev/null
